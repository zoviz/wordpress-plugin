{
	"name": "zoviz/zoviz-ai-studio",
	"description": "Official Zoviz plugin for WordPress: AI image generation, editing, and enhancement powered by the Zoviz Developer API.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/zoviz/wordpress-plugin",
	"support": {
		"issues": "https://github.com/zoviz/wordpress-plugin/issues"
	},
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"mockery/mockery": "^1.6",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.0",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"wp-phpunit/wp-phpunit": "^6.4",
		"yoast/phpunit-polyfills": "^1.1 || ^2.0 || ^3.0"
	},
	"autoload": {
		"psr-4": {
			"Zoviz\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Zoviz\\Tests\\": "tests/"
		}
	},
	"config": {
		"platform": {
			"php": "7.4.33"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G",
		"test:unit": "phpunit -c phpunit.xml.dist",
		"test:integration": "phpunit -c phpunit-integration.xml.dist"
	}
}
