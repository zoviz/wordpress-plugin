{
	"name": "zoviz-ai-studio",
	"private": true,
	"description": "Official Zoviz plugin for WordPress: AI image generation, editing, and enhancement powered by the Zoviz Developer API.",
	"license": "GPL-2.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/zoviz/wordpress-plugin.git"
	},
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@testing-library/jest-dom": "^6.4.0",
		"@testing-library/react": "^16.0.0",
		"@testing-library/user-event": "^14.5.0",
		"@wordpress/env": "^11.0.0",
		"@wordpress/scripts": "^34.0.0"
	},
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js client",
		"test:js": "wp-scripts test-unit-js --passWithNoTests",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"test:php:integration": "wp-env run tests-cli --env-cwd=wp-content/plugins/zoviz-ai-studio vendor/bin/phpunit -c phpunit-integration.xml.dist"
	}
}
